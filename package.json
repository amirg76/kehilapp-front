{
  "lint-staged": {
    "*.+(js|jsx|ts|jsx)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*styles.ts": [
      "npm run lint:css"
    ],
    "*.+(json|md)": [
      "prettier --write"
    ]
  },
  "name": "react-boiler-plate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint . --ext .js,.jsx --report-unused-disable-directives",
    "lint:css": "stylelint './src/**/*styles.ts'",
    "url-safety-check": "node scripts/url-safety-check.mjs",
    "render-check": "node scripts/render-check.mjs",
    "password-policy-check": "node scripts/password-policy-check.mjs",
    "email-policy-check": "node scripts/email-policy-check.mjs",
    "bidi-text-check": "node scripts/bidi-text-check.mjs",
    "check": "npm run url-safety-check && npm run render-check && npm run password-policy-check && npm run email-policy-check && npm run bidi-text-check",
    "prettier": "prettier --ignore-path .gitignore \"**/*.+(js|jsx|json|css)\"",
    "format": "npm run prettier -- --write",
    "check-format": "npm run prettier -- --list-different",
    "validate": "npm-run-all --parallel check-format lint && npm run check",
    "lint-staged": "lint-staged",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.4.0",
    "D": "^1.0.0",
    "dompurify": "^3.4.14",
    "html-react-parser": "^5.1.5",
    "quill": "^1.3.7",
    "quill-magic-url": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-query": "^3.39.3",
    "react-quill": "^2.0.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.14.2",
    "router": "^1.3.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/axios": "^0.14.0",
    "@types/node": "^20.4.8",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.16",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-styled-components": "^2.1.4",
    "dotenv": "^16.3.1",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-security": "^1.7.1",
    "husky": "^8.0.3",
    "joi": "^17.9.2",
    "lint-staged": "^13.2.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.32",
    "postcss-scss": "^4.0.6",
    "prettier": "^3.0.1",
    "stylelint-config-recommended": "^13.0.0",
    "tailwindcss": "^3.3.6",
    "vite": "^4.4.5"
  }
}
