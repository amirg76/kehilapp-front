# dependencies
node_modules

# env files
.env
.env.*

# misc
.DS_Store
.vscode
README

.vite/

# ...but the example MUST be committed: it documents the required vars, and a
# missing one is what produced the white screen. The negation has to sit on its
# own line - glued onto `.vite/` it never applied, so `.env.*` was quietly
# ignoring `.env.example` too.
!.env.example

# Vite build output (this project outputs to build/, not dist/).
build

# Playwright and probe output. These are generated by running the suite and the
# browser probes from this directory, and they have no business in the repo --
# both of this project's past secret leaks were in files an extension-filtered
# scan walked past, so artifacts get named explicitly rather than trusted to
# stay out on their own.
test-results/
playwright-report/
.playwright-mcp/
*-probe.png
admin-login.png
